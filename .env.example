# Copy this file to .env and fill in the values you need.
# Load it before running:  set -a; source .env; set +a
#
# WHICH KEYS DO I NEED?  It depends on how you route the LLM agents and the
# memory provider in pkms.config.yaml. Rule of thumb:
#   - route every agent to `ollama` + memory.provider `none`  → NO keys needed
#     (fully local, CPU-only, zero cost).
#   - any agent routed to `claude`                            → ANTHROPIC_API_KEY
#   - any agent routed to `groq`                              → GROQ_API_KEY
#   - memory.provider: mem0                                   → MEM0_API_KEY
# The shipped default config routes compiler+querier to `groq`, so out of the
# box you need GROQ_API_KEY (or re-route those agents to `ollama`/`claude`).

# ── LLM backend keys (needed per your llm_router.agents choices) ──────────────

# Anthropic (Claude) — required if any agent in llm_router.agents is `claude`.
# Get one at https://console.anthropic.com  → keys look like  sk-ant-...
ANTHROPIC_API_KEY=sk-ant-...

# Groq — required if any agent in llm_router.agents is `groq` (the default for
# compiler + querier). Fast OpenAI-compatible inference; free tier available.
# Get one at https://console.groq.com/keys  → keys look like  gsk_...
GROQ_API_KEY=gsk_...

# ── Memory provider key (only for memory.provider: mem0) ──────────────────────

# Mem0 managed platform — required ONLY if you set memory.provider: mem0 in
# pkms.config.yaml. Powers the Querier's long-term recall of past Q&A.
# Get one at https://app.mem0.ai  → keys look like  m0-...
# (Other memory providers need no key: `none` = default, `amem` = local SQLite,
#  `mempalace` = local, installed via  pip install '.[mempalace]'.)
MEM0_API_KEY=m0-...

# ── Optional overrides (defaults already match docker-compose.yml) ────────────

# Qdrant (vector store)
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# Ollama (local LLM + embeddings)
# OLLAMA_HOST=localhost
# OLLAMA_PORT=11434

# Web API
# PKMS_HOST=0.0.0.0
# PKMS_PORT=8000
